{
  "name": "myrenamer",
  "version": "0.2.2",
  "description": "Rename Zawgyi <-=-> Unicode - A tool to convert file and folder names between Zawgyi and Unicode encodings",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "test": "mocha -r ts-node/register ./test/*.spec.ts",
    "build": "tsc",
    "lint": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'"
  },
  "keywords": [
    "Rename Zawgyi<=>Unicode",
    "zawgyi",
    "unicode",
    "myanmar",
    "file-renamer",
    "encoding-converter"
  ],
  "author": "Aung Myo Kyaw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AungMyoKyaw/myRenamer.git"
  },
  "bugs": {
    "url": "https://github.com/AungMyoKyaw/myRenamer/issues"
  },
  "homepage": "https://github.com/AungMyoKyaw/myRenamer#README",
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "mocha": "^10.2.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "myanmar-tools": "^1.1.1"
  }
}
